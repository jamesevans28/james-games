{
  "name": "james-games-monolith",
  "version": "1.0.0",
  "private": true,
  "description": "Games4James monorepo: player web app, backend API and admin console.",
  "workspaces": [
    "apps/player-web",
    "apps/backend-api",
    "apps/admin-web"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/player-web",
    "server": "npm run dev --workspace apps/backend-api",
    "admin:dev": "npm run dev --workspace apps/admin-web",
    "web:build": "npm run build --workspace apps/player-web",
    "web:build:no-seo": "npm run build:no-seo --workspace apps/player-web",
    "admin:build": "npm run build --workspace apps/admin-web",
    "backend:build": "npm run build --workspace apps/backend-api",
    "build": "npm run web:build && npm run admin:build && npm run backend:build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "web:asset:snapadile": "npm run generate-snapadile-assets --workspace apps/player-web",
    "web:asset:car-crash": "npm run generate-car-crash-assets --workspace apps/player-web",
    "web:generate-sitemap": "npm run generate-sitemap --workspace apps/player-web",
    "web:generate-seo": "npm run generate-seo --workspace apps/player-web"
  },
  "devDependencies": {
    "pureimage": "^0.3.17",
    "word-list": "^4.1.0"
  }
}
