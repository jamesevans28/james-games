{
  "name": "games4james-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/lambda.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "DOTENV_CONFIG_PATH=.env.local tsx --require dotenv/config src/dev-server.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project backend-api --root ../..",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "DOTENV_CONFIG_PATH=.env.local tsx --require dotenv/config src/db/migrate.ts",
    "db:seed": "DOTENV_CONFIG_PATH=.env.local tsx --require dotenv/config src/db/seed.ts",
    "db:ping": "DOTENV_CONFIG_PATH=.env.local tsx --require dotenv/config src/db/ping.ts",
    "db:housekeeping": "DOTENV_CONFIG_PATH=.env.local tsx --require dotenv/config src/db/housekeeping.run.ts",
    "bundle": "node scripts/bundle.mjs",
    "auth:view": "tsx scripts/view-auth-user.ts",
    "legacy:import": "tsx scripts/migrate-prototype.ts"
  },
  "dependencies": {
    "@resvg/resvg-wasm": "2.6.2",
    "@supabase/auth-js": "2.118.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "jose": "6.2.13",
    "obscenity": "^0.4.6",
    "postgres": "^3.4.9",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "opentype.js": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
