{
  "name": "games4james-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/lambda.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "DOTENV_CONFIG_PATH=.env.local tsx --require dotenv/config src/dev-server.ts",
    "seed:game-configs": "node ./scripts/seed-game-configs-standalone.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project backend-api --root ../.."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1147.0",
    "@aws-sdk/lib-dynamodb": "^3.1147.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "dotenv": "^18.0.6",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
