# API external base (used to build redirect URIs)
APP_BASE_URL=http://localhost:8787

# Supabase Postgres (plan T6.1). Supabase → Connect → "Transaction pooler" (port 6543)
# for the API, "Session pooler" (port 5432) for migrations. Never commit real values.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL_MIGRATIONS=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase Auth (Phase 14). Local development uses games4james-dev if it exists, else games4james;
# scripts/supabase-auth-setup.mjs writes both values here without printing them.
# SUPABASE_SECRET_KEY is the sb_secret_… key (or the legacy service_role JWT): admin
# API only, never shipped to a browser.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# Stripe webhook signing secret for the family supporter purchase (T12.2). Local
# testing: `stripe listen --forward-to localhost:8787/billing/stripe/webhook` prints one.
STRIPE_WEBHOOK_SECRET=

# RevenueCat webhook Authorization secret for store purchases (T12.3).
REVENUECAT_WEBHOOK_AUTH=
