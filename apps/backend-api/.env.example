# API external base (used to build redirect URIs)
APP_BASE_URL=http://localhost:8787

# Supabase Postgres (plan T6.1). Supabase → Connect → "Transaction pooler" (port 6543)
# for the API, "Session pooler" (port 5432) for migrations. Never commit real values.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
DATABASE_URL_MIGRATIONS=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Firebase Admin SDK config (server-side)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Private key from service account JSON (include the \n characters)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Key-Here\n-----END PRIVATE KEY-----\n"


# Scores table (legacy) — keep existing values if already deployed
TABLE_NAME=games4james-gamescores
SCORE_GSI_NAME=GameScoresByScore
TABLE_RATINGS=games4james-gameratings
TABLE_RATING_SUMMARY=games4james-gameratings-summary
# Screen-name reservations (partition key screenNameKey). Required: name assignment fails without it.
TABLE_USERNAMES=games4james-usernames
AWS_REGION=ap-southeast-2
