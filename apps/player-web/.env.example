# Backend API URL
VITE_API_BASE_URL=http://localhost:8787

# Supabase Auth (Phase 14). Local development uses the games4james-dev project;
# scripts/supabase-auth-setup.mjs writes both values into .env.local for you.
# The publishable key (sb_publishable_…) is meant for browsers; never put the secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
