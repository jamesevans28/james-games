{
  "name": "@james-games/player-web",
  "description": "Games4James: mobile-first Phaser mini-games by James, Tilly and Harvey.",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run generate-seo && vite build",
    "build:no-seo": "vite build",
    "generate-snapadile-assets": "cd ../.. && node scripts/generate-snapadile-assets.mjs",
    "generate-car-crash-assets": "cd ../.. && node scripts/generate-car-crash-assets.mjs",
    "generate-sitemap": "cd ../.. && tsx scripts/export-manifests.mts && node scripts/generate-sitemap.mjs",
    "generate-seo": "cd ../.. && tsx scripts/export-manifests.mts && node scripts/generate-sitemap.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run --project player-web --root ../..",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.6.0",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.0",
    "@capacitor/network": "8.0.1",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@revenuecat/purchases-capacitor": "13.6.0",
    "@supabase/auth-js": "2.119.0",
    "@tanstack/react-query": "^5.106.1",
    "phaser": "^4.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "zod": "^4.6.7"
  }
}
